# ─────────────────────────────────────────────────────────────────────────────
# Floppy web (Next.js) — copy to apps/web/.env.local and fill in.
# Only NEXT_PUBLIC_* values reach the browser; never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Node API runs.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (Open Graph links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Clerk ───────────────────────────────────────────────────────────────────
# Same Clerk application as the API (Clerk dashboard → API keys).
# Production: use the production instance's pk_live_ / sk_live_ keys.
# The CSP reads the Clerk hostname from the publishable key; rebuild after changing it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Novu Inbox ──────────────────────────────────────────────────────────────
# Optional: the API also returns it. Novu dashboard → Developer → Application Identifier.
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
# EU region only:
# NEXT_PUBLIC_NOVU_BACKEND_URL=https://eu.api.novu.co
# NEXT_PUBLIC_NOVU_SOCKET_URL=wss://eu.socket.novu.co
NEXT_PUBLIC_NOVU_BACKEND_URL=
NEXT_PUBLIC_NOVU_SOCKET_URL=

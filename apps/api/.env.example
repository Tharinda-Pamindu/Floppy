# ─────────────────────────────────────────────────────────────────────────────
# Floppy API — copy to apps/api/.env and fill in. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# The Next.js app's origin: the only origin CORS and Socket.IO accept.
WEB_ORIGIN=http://localhost:3000
# Where this API is reachable from the internet (Novu calls the /api/novu bridge here).
API_PUBLIC_URL=http://localhost:4000

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Runtime: the transaction pooler (port 6543) is fine.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations need a session connection: direct (db.<ref>.supabase.co:5432) or session pooler (port 5432).
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# ── Authentication (Clerk) ──────────────────────────────────────────────────
# Clerk dashboard → API keys.
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Clerk dashboard → Webhooks → endpoint https://<API_PUBLIC_URL>/webhooks/clerk → Signing secret.
# Optional locally (the API lazily syncs users/memberships without it).
CLERK_WEBHOOK_SIGNING_SECRET=
# true = Clerk's verification / password-reset / invitation emails and SMS are
# delivered by Novu (set those Clerk templates to "Delivered by you" first).
CLERK_EMAILS_VIA_NOVU=false

# ── Notifications (Novu Cloud) ──────────────────────────────────────────────
# Novu dashboard → Developer → API Keys. Empty = notifications are skipped.
NOVU_SECRET_KEY=
# Same page: "Application Identifier" (also used by the web app's <Inbox />).
NOVU_APPLICATION_IDENTIFIER=
# EU region only: https://eu.api.novu.co
NOVU_API_URL=
# Email (Resend) and SMS (Twilio) keys are entered in Novu → Integrations,
# not here. See README → "Notifications".

# ── GitHub (optional) ───────────────────────────────────────────────────────
# Public repos work without it. A fine-grained token with "Issues: read" and
# "Metadata: read" lets teams link private repos and raises the rate limit.
GITHUB_TOKEN=

# ── AI (on hold) ────────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to keep the AI features hidden. Any OpenAI-compatible
# endpoint works: Groq (default below) or xAI (https://api.x.ai/v1, e.g. grok-3-mini).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=6

# ── Jobs ────────────────────────────────────────────────────────────────────
# Weekly and deadline reminders (node-cron, every 15 minutes).
REMINDERS_ENABLED=true

# ── Demo data ───────────────────────────────────────────────────────────────
# `npm run db:seed` gives every demo account this password (8+ characters).
DEMO_PASSWORD=

{
  "name": "@floppy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsc -p ../../packages/shared/tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "staff:create": "tsx --env-file-if-exists=.env scripts/create-platform-user.ts --role staff",
    "superadmin:create": "tsx --env-file-if-exists=.env scripts/create-platform-user.ts --role superadmin",
    "notify:test": "tsx --env-file-if-exists=.env scripts/notify-test.ts",
    "novu:dev": "npx novu@latest dev --port 4000 --route /api/novu",
    "novu:sync": "tsx --env-file-if-exists=.env scripts/novu-sync.ts",
    "pretest": "tsc -p ../../packages/shared/tsconfig.json",
    "prebuild": "tsc -p ../../packages/shared/tsconfig.json"
  },
  "dependencies": {
    "@clerk/express": "2.1.78",
    "@floppy/shared": "0.1.0",
    "@novu/api": "3.19.1",
    "@novu/framework": "2.14.0",
    "@octokit/rest": "22.0.1",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "node-cron": "4.6.0",
    "openai": "7.33.0",
    "postgres": "3.4.9",
    "socket.io": "4.8.4",
    "svix": "2.8.0",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4"
  }
}
